<ci:SettingsPageBase x:Class="ExtraIsland.SettingPages.DutySettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:ExtraIsland.Controls"
                     xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:settingPages="clr-namespace:ExtraIsland.SettingPages"
                     xmlns:sc="clr-namespace:ExtraIsland.Shared.Converters"
                     mc:Ignorable="d"
                     Unloaded="DutySettingsPage_OnUnloaded">
    <ci:SettingsPageBase.Resources>
        <sc:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </ci:SettingsPageBase.Resources>


    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=settingPages:DutySettingsPage}}">
        <StackPanel Classes="settings-container animated-intro">
            <Label FontSize="20"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                ExtraIsland
            </Label>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ci:FluentIcon FontSize="60"
                    Glyph="&#xECDA;"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <Label VerticalAlignment="Center" FontSize="30">全局 · 值日表</Label>
            </StackPanel>
            
            <controls1:InfoBar Severity="Warning" IconSource="{ci:FluentIconSource &#xF430;}" IsOpen="True" IsClosable="False">
                <controls1:InfoBar.Title>
                    本功能将只提供简单的值日表功能, 将不会增加任何奇怪或复杂的轮换方案, 如需更高级的值日表, 请移步 DutyIsland
                </controls1:InfoBar.Title>
            </controls1:InfoBar>
            
            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE4C4;}"
                                        Header="时间" IsExpanded="True">
                <controls1:SettingsExpander.Footer>
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="8 0" Height="28" CornerRadius="14"
                            Background="{DynamicResource ControlFillColorTransparentBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Label VerticalAlignment="Center">上次更新</Label>
                            <Label VerticalAlignment="Center" x:Name="LastUpdateLabel"
                                   Content="{Binding Settings.Data.LastUpdate}"/>
                        </StackPanel>
                    </Border>
                </controls1:SettingsExpander.Footer>
                
                <controls1:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE5C9;}"
                                                Content="自动时间抹零" Description="开启后，每次更新都将只记录日期数据">
                    <controls1:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.Data.IsAutoShearEnabled}" />
                    </controls1:SettingsExpanderItem.Footer>
                </controls1:SettingsExpanderItem>
                
                <controls1:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE131;}"
                                                Content="时间抹零" IsClickEnabled="True"
                                                Click="ClearTimeButton_OnClick" />
            </controls1:SettingsExpander>
            
            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xECDB;}" Header="值日列表" IsExpanded="True">
                <controls1:SettingsExpander.Footer>
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="8 0" Height="28" CornerRadius="14"
                            Background="{DynamicResource ControlFillColorTransparentBrush}">
                        <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                            <Label Content="当前索引" />
                            <Label x:Name="IndexOnDutyLabel" Content="{Binding Settings.Data.CurrentPeopleIndex}" />
                            <Label Content="@" />
                            <Label x:Name="PeopleOnDutyLabel" Content="{Binding Settings.PeoplesOnDutyString}" />
                        </StackPanel>
                    </Border>
                </controls1:SettingsExpander.Footer>
                
                <controls1:SettingsExpanderItem>
                    <DataGrid x:Name="PeopleDataGrid"
                              Margin="6,6,6,0"
                              MaxHeight="240"
                              IsReadOnly="False"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              ItemsSource="{Binding Settings.Data.Peoples, Mode=TwoWay}"
                              CurrentCellChanged="PeopleDataGrid_OnCurrentCellChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="索引" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding Index}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <controls1:NumberBox SpinButtonPlacementMode="Compact" 
                                                             Value="{Binding Index}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="姓名" IsReadOnly="False"
                                                Width="*"
                                                Binding="{Binding Name}" />
                            
                            <DataGridTemplateColumn Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Theme="{StaticResource TransparentButton}"
                                                Width="20" Height="20"
                                                Margin="4 0 0 0" Padding="0"
                                                Click="DeleteButton_Click">
                                            <ci:IconText Glyph="&#xE61D;" Text="删除" Foreground="Red" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </controls1:SettingsExpanderItem>
                
                <controls1:SettingsExpanderItem>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Click="AddButton_Click">
                            <ci:IconText Glyph="&#xE00D;" Text="新建" />
                        </Button>
                        <Button ToolTip.Tip="从文本文件导入" Click="ImportButton_OnClick"> 
                            <ci:IconText Glyph="&#xE0D9;" Text="导入" />
                        </Button>
                        <Button ToolTip.Tip="重新索引" Click="AutoSort_OnClick">
                            <ci:IconText Glyph="&#xF17E;" Text="排序" />
                        </Button>
                        <Button x:Name="DebugSwapButton" IsVisible="False"
                                ToolTip.Tip="[Debug]手动触发交班"
                                Click="DebugButton_OnClick">
                            <ci:IconText Glyph="&#xE13B;" Text="[Debug]交班" />
                        </Button>
                    </StackPanel>
                </controls1:SettingsExpanderItem>
            </controls1:SettingsExpander>
            
            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xEC26;}"
                                        Header="索引" Description="手动修改当前索引">
                <controls1:SettingsExpander.Footer>
                    <controls1:NumberBox MinWidth="20" SpinButtonPlacementMode="Compact"
                                         Value="{Binding Settings.Data.CurrentPeopleIndex}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>
            
            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE0BD;}"
                                        Header="循环" Description="开启后，每当列表遍历完毕，索引将自动归零">
                <controls1:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Data.IsCycled}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>
            
            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE304;}"
                                        Header="自动跳过节假日" Description="自动跳过国定假日和双休日的值日轮换"
                                        IsExpanded="{Binding Settings.Data.IsHolidaySkipEnabled, Mode=OneWay}">
                <controls1:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal">
                        <controls:ExperimentalBadge/>
                        <ToggleSwitch IsChecked="{Binding Settings.Data.IsHolidaySkipEnabled}"/>
                    </StackPanel>
                </controls1:SettingsExpander.Footer>
                
                <controls1:SettingsExpanderItem>
                    <controls1:InfoBar Severity="Informational" IconSource="{ci:FluentIconSource &#xF430;}" IsOpen="True" IsClosable="False">
                        <controls1:InfoBar.Title>
                            本功能使用 timor.tech API 跳过国家法定假日/调休日/双休日
                        </controls1:InfoBar.Title>
                    </controls1:InfoBar>
                </controls1:SettingsExpanderItem>
                
                <controls1:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE31C;}"
                                                Content="节假日跳过历史" Description="上次跳过的节假日信息">
                    <controls1:SettingsExpanderItem.Footer>
                        <TextBlock x:Name="LastSkippedHolidayLabel"
                                   TextWrapping="Wrap"
                                   Text="暂无&#x0a;- → -" />
                    </controls1:SettingsExpanderItem.Footer>
                </controls1:SettingsExpanderItem>
                
                <controls1:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE31A;}"
                                                Content="即将跳过的节假日" Description="下一个将要跳过的节假日">
                    <controls1:SettingsExpanderItem.Footer>
                        <TextBlock x:Name="NextHolidayLabel"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   Text="---" />
                    </controls1:SettingsExpanderItem.Footer>
                </controls1:SettingsExpanderItem>
            </controls1:SettingsExpander>
                    
            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xEFEF;}"
                                        Header="轮换间隔" Description="轮换到下一位间隔的天数">
                <controls1:SettingsExpander.Footer>
                    <controls1:NumberBox MinWidth="20" SpinButtonPlacementMode="Compact"
                                         Value="{Binding Settings.Data.DutyChangeDurationDays}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>
            
            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xECFB;}"
                                        Header="轮换方式" Description="选择值日生轮换方法">
                <controls1:SettingsExpander.Footer>
                    <ComboBox SelectedItem="{Binding Settings.Data.DutyState}"
                              ItemsSource="{Binding DutyStates}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>