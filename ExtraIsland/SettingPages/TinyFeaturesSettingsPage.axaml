<ci:SettingsPageBase x:Class="ExtraIsland.SettingPages.TinyFeaturesSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:sc="clr-namespace:ExtraIsland.Shared.Converters"
                     xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:settingPages="clr-namespace:ExtraIsland.SettingPages"
                     mc:Ignorable="d"
                     Unloaded="MiscSettingsPage_OnUnloaded">
    <ci:SettingsPageBase.Resources>
        <sc:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </ci:SettingsPageBase.Resources>
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=settingPages:TinyFeaturesSettingsPage}}">
        <StackPanel Classes="settings-container animated-intro">
            <Label FontSize="20"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                ExtraIsland
            </Label>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ci:FluentIcon
                    FontSize="60"
                    Glyph="&#xEDC4;"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"/>
                <Label VerticalAlignment="Center" Margin="0,5,0,0" FontSize="30">全局 · 微功能</Label>
            </StackPanel>
            <!--fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xF1AE;}"
                                       Header="导引界面"
                                       Description="下次启动开始将显示导引界面,直到选择不再显示">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.JuniorGuide.Enabled}"/>
                </fa:FASettingsExpander.Footer>
                <fa:FASettingsExpanderItem Content="标题">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBox MinWidth="50"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 Text="{Binding Settings.JuniorGuide.Header}"
                                 Margin="3,0,3,0"/>   
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="内容">
                    <fa:FASettingsExpanderItem.Footer>
                        <ci:FluentIcon Glyph="&#xEB5D;"/>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        Margin="30,0,0,0"
                        CornerRadius="5">
                    <TextBox Text="{Binding Settings.JuniorGuide.Content}"
                             Background="Transparent"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             Margin="6,6,6,6"/> 
                </Border>
                <fa:FASettingsExpanderItem Content="测试">
                    <fa:FASettingsExpanderItem.Footer>
                        <Button Click="DebugShowButton_OnClick"
                                Padding="0"
                                Width="33">
                            <Button.Content>
                                <ci:FluentIcon Glyph="&#xEEA0;" Margin="2,6,3,6"/>
                            </Button.Content>
                        </Button>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="保持时间">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBox MinWidth="50"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 Text="{Binding Settings.JuniorGuide.KeepTime, Converter={StaticResource IntToStringConverter}}"
                                 Margin="3,0,3,0"/>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="指南目标">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBox MinWidth="50"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 Text="{Binding Settings.JuniorGuide.Link}"
                                 Margin="3,0,3,0"/>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </-->
            <fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE0BB;}"
                                       Header="(隐藏设置) 主界面启用鼠标点击"
                                       Description="允许鼠标与主界面上的控件交互"
                                       Click="ToggleButton_OnChecked">
                <fa:FASettingsExpander.Footer>
                    <!--ToggleSwitch IsChecked="{Binding AppSettings.IsMouseClickingEnabled, Mode=TwoWay}"/-->
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>