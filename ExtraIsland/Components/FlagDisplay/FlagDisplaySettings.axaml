<ci:ComponentBase xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:components="clr-namespace:ExtraIsland.Components"
                  xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  x:Class="ExtraIsland.Components.FlagDisplaySettings"
                  x:TypeArguments="components:FlagDisplayConfig">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=components:FlagDisplaySettings}}">
        <StackPanel Classes="settings-container animated-intro">
            <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xE844;}"
                                   Header="标志 ID"
                                   Description="要展示的标志 ID,由「设标志」行动设定">
                <fa:FASettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.TargetFlag, Mode=TwoWay}"
                             MinWidth="40"
                             MaxWidth="150"
                             HorizontalContentAlignment="Right"/>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xE71B;}"
                                   Header="占位文本"
                                   Description="标志未设置时显示的内容">
                <fa:FASettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.FallbackText, Mode=TwoWay}"
                             MinWidth="80"
                             MaxWidth="150"
                             HorizontalContentAlignment="Right"/>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xE051;}"
                                   Header="启用动画"
                                   Description="关闭后,动画将不被播放,对低性能设备友好!">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsAnimationEnabled, Mode=TwoWay}"/>
                </fa:FASettingsExpander.Footer>
                <fa:FASettingsExpander.Items>
                    <fa:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xE095;}"
                                                   Content="启用切换动画"
                                                   Description="启用后,内容变化时将播放切换动画">
                        <fa:FASettingsExpanderItem.Footer>
                            <ToggleSwitch IsEnabled="{Binding Settings.IsAnimationEnabled, Mode=OneWay}"
                                          IsChecked="{Binding Settings.IsSwapAnimationEnabled, Mode=TwoWay}"/>
                        </fa:FASettingsExpanderItem.Footer>
                    </fa:FASettingsExpanderItem>
                </fa:FASettingsExpander.Items>
            </fa:FASettingsExpander>
            <Label HorizontalAlignment="Center"
                   Foreground="{DynamicResource MaterialDesignBodyLight}">
                Added by ExtraIsland
            </Label>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
