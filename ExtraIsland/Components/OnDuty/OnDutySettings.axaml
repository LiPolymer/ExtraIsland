<ci:ComponentBase x:Class="ExtraIsland.Components.OnDutySettings"
                   x:TypeArguments="local:OnDutyConfig"
                   xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:ExtraIsland.Components"
                   xmlns:ci="http://classisland.tech/schemas/xaml/core"
                   xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                   mc:Ignorable="d"
                   d:DesignHeight="300" d:DesignWidth="300">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:OnDutySettings}}">
        <StackPanel Classes="settings-container animated-intro">
            <fa:FAInfoBar Severity="Informational"
                              IsClosable="False"
                              Message="本页面仅包含组件设置,要调整值日设置,请转到 ⌈ExtraIsland > 值日表⌋"
                              IsOpen="True">
            </fa:FAInfoBar>
            <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xE04B;}"
                                       Header="紧凑模式" Description="启用双行显示">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsCompactModeEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            
            <Label HorizontalAlignment="Center" 
                   Foreground="{DynamicResource MaterialDesignBodyLight}">
                Added by ExtraIsland
            </Label>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
