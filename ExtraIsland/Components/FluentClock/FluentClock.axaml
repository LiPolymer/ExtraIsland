<ci:ComponentBase xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:components="clr-namespace:ExtraIsland.Components"
                  xmlns:converters="clr-namespace:ExtraIsland.Shared.Converters"
                  mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                  x:Class="ExtraIsland.Components.FluentClock"
                  x:TypeArguments="components:FluentClockConfig"
                  ClipToBounds="True"
                  AttachedToVisualTree="OnAttachedToVisualTree" 
                  DetachedFromVisualTree="OnDetachedFromVisualTree">
     <ci:ComponentBase.Resources>
        <ci:SizeDoubleToCornerRadiusConverter x:Key="SizeDoubleToCornerRadiusConverter"/>
    </ci:ComponentBase.Resources>
    <Grid Margin="0" ClipToBounds="True">
        <Grid x:Name="EmpBack" Opacity="0" HorizontalAlignment="Center" Width="{Binding #RootPanel.Bounds.Width}">
            <Border Background="{DynamicResource Rainy}"
                    ClipToBounds="True"
                    BorderThickness="1"
                    Padding="0"
                    Opacity="0.3"
                    VerticalAlignment="Center"
                    CornerRadius="{Binding Bounds.Height, RelativeSource={RelativeSource Self}, Converter={StaticResource SizeDoubleToCornerRadiusConverter}}">
                <Label x:Name="Placeholder1"
                       Margin="6,0,6,-4"
                       Content="▯"
                       Opacity="0"
                       FontSize="{DynamicResource MainWindowEmphasizedFontSize}"/>
            </Border>
            <Border ClipToBounds="True"
                    BorderBrush="{DynamicResource Rainy}"
                    BorderThickness="1"
                    Padding="0 0"
                    VerticalAlignment="Center"
                    CornerRadius="{Binding Bounds.Height, RelativeSource={RelativeSource Self}, Converter={StaticResource SizeDoubleToCornerRadiusConverter}}">
                <Label x:Name="Placeholder2"
                       Margin="6,0,6,-4"
                       Content="▯"
                       Opacity="0"
                       FontSize="{DynamicResource MainWindowEmphasizedFontSize}"/>
            </Border>
        </Grid>
        <StackPanel
            DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=components:FluentClock}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="1,3,0,0"
            UseLayoutRounding="True"
            x:Name="RootPanel"
            Classes.SmallSecondsEnabled = "{Binding Settings.IsSecondsSmall, Mode=OneWay}"
            Orientation="Horizontal">
            <StackPanel.Styles>
                <Style Selector="StackPanel#RootPanel">
                    <Style Selector="^ Label#LSecs">
                        <Setter Property="FontSize" Value="{DynamicResource MainWindowEmphasizedFontSize}"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                    <Style Selector="^.SmallSecondsEnabled Label#LSecs">
                        <Setter Property="FontSize" Value="{DynamicResource MainWindowSecondaryFontSize}"/>
                        <Setter Property="Margin" Value="0,3,0,0"/>
                    </Style>
                    <Style Selector="^ Label#SSecs">
                        <Setter Property="FontSize" Value="{DynamicResource MainWindowLargeFontSize}"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                    <Style Selector="^.SmallSecondsEnabled Label#SSecs">
                        <Setter Property="FontSize" Value="{DynamicResource MainWindowSecondaryFontSize}"/>
                        <Setter Property="Margin" Value="0,3,0,0"/>
                    </Style>
                </Style>
            </StackPanel.Styles>
            <Label
                Content="--"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{DynamicResource MainWindowEmphasizedFontSize}"
                Padding="2,0,2,0"
                TextElement.FontFeatures="tnum"
                x:Name="LHours">
                <Label.RenderTransform>
                    <TranslateTransform />
                </Label.RenderTransform>
            </Label>
            <Label
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{DynamicResource MainWindowLargeFontSize}"
                Padding="0,0,0,4"
                Content=":"
                x:Name="SMins" />
            <Label
                Content="--"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalAlignment="Center"
                Padding="2,0,2,0"
                FontSize="{DynamicResource MainWindowEmphasizedFontSize}"
                TextElement.FontFeatures="tnum"
                x:Name="LMins">
                <Label.RenderTransform>
                    <TranslateTransform />
                </Label.RenderTransform>
            </Label>
            <Label
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalAlignment="Center"
                Content=":"
                Padding="0,0,0,4"
                x:Name="SSecs" />
            <Label
                Content="--"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="2,0,0,0"
                TextElement.FontFeatures="tnum"
                x:Name="LSecs">
                <Label.RenderTransform>
                    <TranslateTransform/>
                </Label.RenderTransform>
            </Label>
        </StackPanel>
    </Grid>   
</ci:ComponentBase>
