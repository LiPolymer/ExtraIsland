<ci:ComponentBase xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:components="clr-namespace:ExtraIsland.Components"
                  mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                  x:Class="ExtraIsland.Components.FluentClock"
                  x:TypeArguments="components:FluentClockConfig"
                  ClipToBounds="True"
                  AttachedToVisualTree="OnAttachedToVisualTree" 
                  DetachedFromVisualTree="OnDetachedFromVisualTree">
     <ci:ComponentBase.Resources>
        <ci:SizeDoubleToCornerRadiusConverter x:Key="SizeDoubleToCornerRadiusConverter"/>
    </ci:ComponentBase.Resources>
    <Grid Margin="0" ClipToBounds="True">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="EmpBack" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Top">
                <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                        ClipToBounds="True"
                        BorderThickness="1"
                        Padding="0"
                        Opacity="0.3"
                        CornerRadius="{Binding Bounds.Height, RelativeSource={RelativeSource Self}, Converter={StaticResource SizeDoubleToCornerRadiusConverter}}" />
                <Border ClipToBounds="True"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="0"
                        CornerRadius="{Binding Bounds.Height, RelativeSource={RelativeSource Self}, Converter={StaticResource SizeDoubleToCornerRadiusConverter}}" />
            </Grid>
            <StackPanel
                DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=components:FluentClock}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="6,0,6,0"
                UseLayoutRounding="True"
                x:Name="RootPanel"
                Classes.SmallSecondsEnabled="{Binding Settings.IsSecondsSmall, Mode=OneWay}"
                Orientation="Horizontal">
                <StackPanel.Styles>
                    <Style Selector="StackPanel#RootPanel">
                        <Style Selector="^ StackPanel#SecondsGroup">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="^.SmallSecondsEnabled StackPanel#SecondsGroup">
                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                        </Style>
                        <Style Selector="^ Label#SSecs">
                            <Setter Property="FontSize" Value="{DynamicResource MainWindowLargeFontSize}"/>
                        </Style>
                        <Style Selector="^.SmallSecondsEnabled Label#SSecs">
                            <Setter Property="FontSize" Value="{DynamicResource MainWindowSecondaryFontSize}"/>
                        </Style>
                        <Style Selector="^ StackPanel#SecsPanel > Label">
                            <Setter Property="FontSize" Value="{DynamicResource MainWindowEmphasizedFontSize}"/>
                        </Style>
                        <Style Selector="^.SmallSecondsEnabled StackPanel#SecsPanel > Label">
                            <Setter Property="FontSize" Value="{DynamicResource MainWindowSecondaryFontSize}"/>
                        </Style>
                    </Style>
                </StackPanel.Styles>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    x:Name="HoursPanel">
                    <Label Content="-" Padding="0" TextElement.FontFeatures="tnum" x:Name="LHourTens" FontSize="{DynamicResource MainWindowEmphasizedFontSize}">
                        <Label.RenderTransform><TranslateTransform /></Label.RenderTransform>
                    </Label>
                    <Label Content="-" Padding="0" TextElement.FontFeatures="tnum" x:Name="LHourUnits" FontSize="{DynamicResource MainWindowEmphasizedFontSize}">
                        <Label.RenderTransform><TranslateTransform /></Label.RenderTransform>
                    </Label>
                </StackPanel>
                <Label
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource MainWindowLargeFontSize}"
                    Padding="0"
                    Content=":"
                    x:Name="SMins">
                    <Label.RenderTransform><TranslateTransform /></Label.RenderTransform>
                </Label>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    x:Name="MinsPanel">
                    <Label Content="-" Padding="0" TextElement.FontFeatures="tnum" x:Name="LMinTens" FontSize="{DynamicResource MainWindowEmphasizedFontSize}">
                        <Label.RenderTransform><TranslateTransform /></Label.RenderTransform>
                    </Label>
                    <Label Content="-" Padding="0" TextElement.FontFeatures="tnum" x:Name="LMinUnits" FontSize="{DynamicResource MainWindowEmphasizedFontSize}">
                        <Label.RenderTransform><TranslateTransform /></Label.RenderTransform>
                    </Label>
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    x:Name="SecondsGroup">
                    <Label
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="0"
                        Content=":"
                        x:Name="SSecs">
                        <Label.RenderTransform><TranslateTransform /></Label.RenderTransform>
                    </Label>
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        x:Name="SecsPanel">
                        <Label Content="-" Padding="0" TextElement.FontFeatures="tnum" x:Name="LSecTens">
                            <Label.RenderTransform><TranslateTransform /></Label.RenderTransform>
                        </Label>
                        <Label Content="-" Padding="0" TextElement.FontFeatures="tnum" x:Name="LSecUnits">
                            <Label.RenderTransform><TranslateTransform /></Label.RenderTransform>
                        </Label>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>   
</ci:ComponentBase>
