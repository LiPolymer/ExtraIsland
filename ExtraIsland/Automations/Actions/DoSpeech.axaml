<ci:ActionSettingsControlBase x:Class="ExtraIsland.Automations.Actions.DoSpeechSettingsControl"
                              x:TypeArguments="actions1:DoSpeechSettings"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:ci="http://classisland.tech/schemas/xaml/core"
                              xmlns:actions1="clr-namespace:ExtraIsland.Automations.Actions"
                              xmlns:controls="clr-namespace:ExtraIsland.Controls"
                              mc:Ignorable="d">
    <StackPanel DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=actions1:DoSpeechSettingsControl}}"
                Spacing="8" Margin="10">
        <TextBlock Text="语音播报"
                   FontWeight="Bold"
                   FontSize="14" />

        <TextBox Text="{Binding Settings.Text, Mode=TwoWay}"
                 Watermark="请输入要播报的文字"
                 AcceptsReturn="True"
                 Height="120"
                 Width="420"/>
    </StackPanel>
</ci:ActionSettingsControlBase>

